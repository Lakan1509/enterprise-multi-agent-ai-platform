# Example environment configuration for CASI.
# Copy to .env and adjust. Never commit real secrets.

# --- API authentication -----------------------------------------------------
# Admin API key (X-API-Key header -> ADMIN role). Must be >= 32 chars and not
# a placeholder when auth is required (see CASI_REQUIRE_AUTH / CASI_HOST).
CASI_API_KEY=

# Optional role keys (same header; unknown/missing key -> 401 when any key set).
CASI_OPERATOR_API_KEY=
CASI_VIEWER_API_KEY=

# Force auth even on loopback. Startup fails fast without a strong CASI_API_KEY.
CASI_REQUIRE_AUTH=false

# API bind address/port. Any non-loopback CASI_HOST requires a strong
# CASI_API_KEY at startup (fail fast). Loopback without a key logs a warning.
CASI_HOST=127.0.0.1
CASI_PORT=8000

# --- Data / workspace -------------------------------------------------------
# Where CASI stores goals, runs, memory, audit logs, workspace files.
CASI_DATA_DIR=./.casi-data

# Workspace root for agent-produced artifacts (defaults to <CASI_DATA_DIR>/workspace).
CASI_WORKSPACE_DIR=

# Parallel task execution limit.
CASI_MAX_WORKERS=4

# --- Model providers --------------------------------------------------------
# Default model provider: "mock" (deterministic, no network), "ollama", or "nebius".
CASI_DEFAULT_PROVIDER=mock

# Ollama (local). Only used when CASI_DEFAULT_PROVIDER=ollama.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b

# Nebius (OpenAI-compatible cloud). Only used when CASI_DEFAULT_PROVIDER=nebius.
# NEBIUS_API_KEY is read at call time and never stored; unset -> clear error.
NEBIUS_API_KEY=
NEBIUS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1

# --- Sandbox ----------------------------------------------------------------
# Only "strict" (Linux namespace isolation) is supported. Anything else raises.
CASI_SANDBOX_MODE=strict

# Venv to expose read-only at /venv inside the jail (auto-detects current
# venv). Empty string disables. Must live on a userns-compatible filesystem
# (ext4/overlayfs/tmpfs; btrfs is skipped automatically with a warning).
CASI_SANDBOX_VENV=

# Default per-command timeout (seconds) for sandboxed execution.
CASI_REQUEST_TIMEOUT_S=60

# --- Optional integrations --------------------------------------------------
# Base-repo RAG app (POST /query). Unset -> the rag_query tool is disabled.
CASI_RAG_API_URL=
CASI_RAG_API_KEY=
